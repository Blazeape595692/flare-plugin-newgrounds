{
  "$schema": "https://unpkg.com/flare-plugin-sdk@next/skill/flare-plugin/manifest.schema.json",
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "dev.flareplugins.newgrounds",
  "version": "0.4.4",
  "name": "Newgrounds",
  "description": "Browse Newgrounds movies, games, art and audio in Flare, and favourite when signed in",
  "permissions": {
    "mediaNetwork": true
  },
  "platform": {
    "id": "Newgrounds",
    "name": "Newgrounds",
    "description": "Newgrounds' portals, with favourites when you sign in",
    "detector": {
      "priority": 1000
    },
    "loginMethods": [
      {
        "id": "browser",
        "interaction": "WebCookie",
        "title": "Sign in on Newgrounds",
        "description": "Add the account with www.newgrounds.com as the server. Log in on Newgrounds' own page; Flare keeps the session so you can favourite.",
        "cookie": {
          "startUrl": "$accountOrigin/passport",
          "probes": [
            {
              "url": "$accountOrigin/",
              "cookies": [
                {
                  "name": "ng_session",
                  "required": false
                },
                {
                  "name": "vmk1du5I8m",
                  "required": false
                },
                {
                  "name": "passport-auth",
                  "required": false
                },
                {
                  "name": "NG_GG_username",
                  "required": false
                }
              ]
            }
          ]
        }
      },
      {
        "id": "browse",
        "interaction": "Form",
        "title": "Browse without signing in",
        "description": "Add the account with www.newgrounds.com as the server. Enter your Newgrounds username for the profile. Read-only: no favouriting.",
        "fields": [
          {
            "id": "username",
            "type": "Username",
            "label": "Newgrounds username"
          }
        ]
      }
    ],
    "capabilities": {
      "flare.datasource.timeline/v1": {
        "operations": {
          "page": {
            "directions": [
              "refresh",
              "older"
            ]
          }
        }
      },
      "flare.datasource.post/v1": {
        "operations": {
          "detail": {},
          "context": { "directions": ["refresh"] },
          "mutate": {}
        }
      },
      "flare.datasource.profile/v1": {
        "operations": {
          "byId": {},
          "byHandle": {}
        }
      },
      "flare.datasource.search/v1": {
        "operations": {
          "posts": {
            "directions": [
              "refresh",
              "older"
            ]
          },
          "profiles": {
            "directions": [
              "refresh",
              "older"
            ]
          },
          "discoverPosts": {
            "directions": [
              "refresh",
              "older"
            ]
          },
          "discoverProfiles": {
            "directions": [
              "refresh"
            ]
          },
          "discoverHashtags": {
            "directions": [
              "refresh"
            ]
          }
        }
      }
    },
    "timelines": [
      {
        "id": "movies",
        "title": "Featured Movies",
        "icon": "Featured",
        "defaultForNewAccount": true
      },
      {
        "id": "feed",
        "title": "My Feed",
        "icon": "Home",
        "defaultForNewAccount": true
      },
      {
        "id": "feed-movies",
        "title": "Feed: Movies",
        "icon": "Featured"
      },
      {
        "id": "feed-art",
        "title": "Feed: Art",
        "icon": "Heart",
        "display": "Grid"
      },
      {
        "id": "feed-games",
        "title": "Feed: Games",
        "icon": "World"
      },
      {
        "id": "feed-blogs",
        "title": "Feed: Blogs",
        "icon": "List"
      },
      {
        "id": "feed-audio",
        "title": "Feed: Audio",
        "icon": "Channel"
      },
      {
        "id": "movies-latest",
        "title": "Latest Movies",
        "icon": "Local"
      },
      {
        "id": "games",
        "title": "Featured Games",
        "icon": "World"
      },
      {
        "id": "art",
        "title": "Featured Art",
        "icon": "Heart",
        "display": "Grid"
      },
      {
        "id": "audio",
        "title": "Featured Audio",
        "icon": "Channel"
      }
    ],
    "credentialSchemaVersion": 1,
    "timelineSchemaVersion": 1
  }
}
