{
  "$schema": "https://unpkg.com/flare-plugin-sdk@next/skill/flare-plugin/manifest.schema.json",
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "dev.flareplugins.newgrounds",
  "version": "0.1.0",
  "name": "Newgrounds",
  "description": "Browse Newgrounds movies, games, art and audio in Flare",
  "permissions": {
    "mediaNetwork": true
  },
  "platform": {
    "id": "Newgrounds",
    "name": "Newgrounds",
    "description": "Read-only browsing of Newgrounds' public portals",
    "detector": { "priority": 1000 },
    "loginMethods": [
      {
        "id": "browse",
        "interaction": "Form",
        "title": "Browse Newgrounds",
        "description": "Add the account with www.newgrounds.com as the server. Enter your Newgrounds username to use as this account's profile. Browsing is read-only and no password is needed.",
        "fields": [
          { "id": "username", "type": "Username", "label": "Newgrounds username" }
        ]
      }
    ],
    "capabilities": {
      "flare.datasource.timeline/v1": {
        "operations": { "page": { "directions": ["refresh", "older"] } }
      },
      "flare.datasource.post/v1": {
        "operations": { "detail": {} }
      },
      "flare.datasource.profile/v1": {
        "operations": { "byId": {}, "byHandle": {} }
      },
      "flare.datasource.search/v1": {
        "operations": {
          "posts": { "directions": ["refresh", "older"] },
          "profiles": { "directions": ["refresh", "older"] },
          "discoverPosts": { "directions": ["refresh", "older"] },
          "discoverProfiles": { "directions": ["refresh"] },
          "discoverHashtags": { "directions": ["refresh"] }
        }
      }
    },
    "timelines": [
      { "id": "movies", "title": "Featured Movies", "icon": "Featured", "defaultForNewAccount": true },
      { "id": "movies-latest", "title": "Latest Movies", "icon": "Local" },
      { "id": "games", "title": "Featured Games", "icon": "World" },
      { "id": "art", "title": "Featured Art", "icon": "Heart", "display": "Grid" },
      { "id": "audio", "title": "Featured Audio", "icon": "Channel" }
    ],
    "credentialSchemaVersion": 1,
    "timelineSchemaVersion": 1
  }
}
